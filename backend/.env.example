# Spring Boot does not read .env files by itself. Set these as environment variables
# (see README for PowerShell) or enter them in your IDE run configuration. Placeholders only.
DB_URL=jdbc:postgresql://localhost:5432/phishguard
DB_USER=phishguard
DB_PASSWORD=change-me
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
RETENTION_DAYS=30
SUSPICIOUS_MIN=30
HIGH_RISK_MIN=60
RATE_LIMIT_SCANS_PER_MIN=30
RATE_LIMIT_READS_PER_MIN=300
# Optional reputation providers. Leave blank to disable. Setting a key means scanned URLs are sent to that provider.
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
INTEL_TIMEOUT_MS=3000
INTEL_CACHE_SECONDS=600
